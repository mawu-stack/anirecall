# AniRecall Environment Variables Example
# Copy this file to .env.local and populate with your credentials.

# Google Gemini API Key for autonomous LLM reasoning and open-ended extraction
# Get an API key at: https://aistudio.google.com/app/apikey
# If left empty, AniRecall will operate in Curated Ground-Truth Catalog mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Application Port (default: 3000)
PORT=3000
